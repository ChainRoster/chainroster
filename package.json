{
  "name": "chainroster",
  "version": "1.13.0",
  "description": "Address book for EVM addresses with chain activity detection",
  "homepage": "https://chainroster.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChainRoster/chainroster.git"
  },
  "bugs": {
    "url": "https://github.com/ChainRoster/chainroster/issues"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "dist": "electron-vite build && electron-builder",
    "dist:linux": "electron-vite build && electron-builder --linux",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:win": "electron-vite build && electron-builder --win"
  },
  "build": {
    "appId": "org.chainroster.app",
    "productName": "ChainRoster",
    "executableName": "chainroster",
    "directories": {
      "output": "release"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "icon": "build/icon.png"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.icns"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "deb": {
      "afterInstall": "build/linux/after-install.sh",
      "afterRemove": "build/linux/after-remove.sh"
    }
  },
  "keywords": [],
  "author": {
    "name": "ChainRoster",
    "email": "chainroster@users.noreply.github.com",
    "url": "https://chainroster.org"
  },
  "license": "ISC",
  "dependencies": {
    "@vitejs/plugin-react": "^5.1.4",
    "electron-vite": "^5.0.0",
    "ethers": "^6.16.0",
    "evm-ui": "file:../evm-ui",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "vite": "^7.3.1"
  },
  "devDependencies": {
    "electron": "^44.4.2",
    "electron-builder": "^26.8.1",
    "sharp": "^0.35.4",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "electron-winstaller": false
  }
}
